# Set the database URI or fields before starting the API.
API_ENVIRONMENT=development
# Clave secreta de al menos 32 caracteres, igual en todos los procesos de API.
# API_SYNC_SIGNING_KEY=

# Choose a URI OR DB_HOST, DB_NAME, DB_USERNAME and DB_PASSWORD.
# SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://user:password@host:5432/database
# The URI takes priority over separate fields. Do not put real secrets here.

# Keycloak test profile. The PEM is a local test certificate, not a token/key.
# OIDC_ISSUER=https://127.0.0.1:18443/realms/nightingale-test
# OIDC_JWKS_URI=https://127.0.0.1:18443/realms/nightingale-test/protocol/openid-connect/certs
# OIDC_TLS_CA_FILE=.tmp/test-services/keycloak-test/keycloak-26.8.1/conf/fixture.pem
# OIDC_PUBLIC_CLIENT_ID=nightingale-desktop-test
# OIDC_AUDIENCE=nightingale-api

# Mantenimiento separado: URI administrativa explícita, nunca heredada de API.
# MAINTENANCE_DATABASE_URI=postgresql+asyncpg://user:password@host:5432/database
